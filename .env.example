# =============================================================================
#  Aegis-Enclave 環境變數範本
# =============================================================================
#
#  ⚠️  警語
#
#  1. 本檔是**範本**，會進版控，因此絕對不可填入任何真實憑證。
#     所有敏感欄位一律留空或填 CHANGE_ME 佔位字串。
#  2. 真實設定請複製為 .env：`cp .env.example .env`
#     `.env` 與 `.env.*` 已被 .gitignore 排除（`.env.example` 為唯一例外），
#     所以本機的 .env 不會被誤推上遠端。
#  3. 在叢集中，敏感值不走 .env，而是由 Kubernetes Secret 掛載成環境變數；
#     .env 只服務於「本機直接跑服務」的開發情境（go run / uv run）。
#  4. 本檔欄位與預設值必須與 docs/CONTRACT.md 第 5 節完全一致。
#     CONTRACT.md 是唯一真實來源；若兩者不符，以 CONTRACT.md 為準並回報。
#
# =============================================================================


# -----------------------------------------------------------------------------
#  gateway（Go + Gin 零信任閘道）
# -----------------------------------------------------------------------------

# 業務流量監聽位址。容器內固定 :8080，Cilium L7 policy 與 Service 都綁定此埠。
AEGIS_LISTEN_ADDR=:8080

# Prometheus 指標監聽位址。刻意與業務埠分離，讓 NetworkPolicy 能只對
# observability 命名空間開放 9090，不必連帶暴露業務端點。
AEGIS_METRICS_ADDR=:9090

# 下游資料面位址。本機開發時改為 http://127.0.0.1:8000。
AEGIS_DATAPLANE_URL=http://dataplane.aegis.svc.cluster.local:8000

# 預期的 JWT issuer。與 audience 一起構成 token 的最小驗證條件，
# 不符者計入 aegis_authn_failures_total{reason="invalid_signature"}。
AEGIS_JWT_ISSUER=https://aegis.local

# 預期的 JWT audience。多租戶時每個閘道實例應有不同 audience，避免 token 橫向重放。
AEGIS_JWT_AUDIENCE=aegis-gateway

# JWKS 驗簽公鑰檔路徑。只含公鑰，因此可安全地以 ConfigMap 掛載；
# 私鑰永遠不進入閘道（閘道只驗簽，不簽發）。
AEGIS_JWKS_PATH=/etc/aegis/jwks.json

# 是否強制用戶端憑證（mTLS）。零信任的核心前提，正式環境不可設為 false；
# 僅在本機用 curl 手動測試時才臨時關閉。
AEGIS_REQUIRE_MTLS=true

# 每個 subject 每秒請求上限。限流以「假名化後的 subject」為鍵，
# 因此限流狀態本身也不含真實身分資料。
AEGIS_RATE_LIMIT_RPS=20

# 突發容量（token bucket 的桶容量）。
AEGIS_RATE_LIMIT_BURST=40

# OTLP collector 端點。留空代表只走 Prometheus pull 模式，
# 這是 demo 的預設路徑（少一個要顧的元件）。
AEGIS_OTEL_ENDPOINT=

# 日誌等級：debug / info / warn / error。
# 注意：debug 也不得輸出原始 PII 或完整 JWT（見 CONTRACT.md 第 4 節）。
AEGIS_LOG_LEVEL=info

# gateway 日誌與 Prometheus 標籤假名化用的 HMAC salt。
# 閘道不持有 KMS 金鑰材料，只用此 salt 做決定論 tokenization
# （subject → sub_ + HMAC-SHA256 前 16 碼十六進位）。
# ⚠️ 敏感值：正式環境由 Kubernetes Secret 注入；範本填 CHANGE_ME，勿填真實 salt。
AEGIS_PSEUDONYM_SALT=CHANGE_ME


# -----------------------------------------------------------------------------
#  dataplane（Python + FastAPI 資料安全服務）
# -----------------------------------------------------------------------------

# KMS driver 三選一：localstack / vault / aws。
# 預設 localstack —— 完全離線、免費，且三個 driver 共用同一組 pytest 合約測試，
# 因此切換 driver 不需要改任何呼叫端程式碼。
AEGIS_KMS_DRIVER=localstack

# 主金鑰識別碼（信封加密中用來包裝 DEK 的 KEK）。
AEGIS_KMS_KEY_ID=alias/aegis-master

# localstack driver 的 KMS 端點。
AEGIS_KMS_ENDPOINT=http://localstack.aegis.svc.cluster.local:4566

# vault driver 的 Vault 位址。
AEGIS_VAULT_ADDR=http://vault.aegis.svc.cluster.local:8200

# ⚠️ 敏感值：Vault token。留空，由 Kubernetes Secret 注入。
# 本機測試請填 dev-only-root-token 之類的臨時值，切勿填入正式 token。
AEGIS_VAULT_TOKEN=

# Vault Transit 引擎的金鑰名稱。
AEGIS_VAULT_TRANSIT_KEY=aegis-master

# aws driver 的區域設定。
AWS_REGION=ap-northeast-1

# 假名化 HMAC 金鑰的識別碼。刻意與主金鑰分離：
# 資料加密金鑰與假名化金鑰若共用，一旦金鑰輪替就會讓歷史日誌無法 join 分析，
# 而分離後可獨立設定兩者的輪替週期（金鑰用途分離，CCSP Domain 2 考點）。
AEGIS_PSEUDONYM_SALT_KEY_ID=alias/aegis-pseudonym

# 區塊鏈 JSON-RPC 端點（本機為 Foundry 的 anvil）。
AEGIS_CHAIN_RPC_URL=http://anvil.aegis.svc.cluster.local:8545

# 碳權合約位址。留空，由 forge script 部署後從
# contracts/deployments/local.json 讀出並注入。
AEGIS_CARBON_CONTRACT_ADDR=

# 日誌等級：debug / info / warn / error。
AEGIS_LOG_LEVEL=info


# -----------------------------------------------------------------------------
#  以下非 CONTRACT.md 契約範圍，僅用於覆寫 Makefile 的預設值（可整段刪除）
# -----------------------------------------------------------------------------

# Kind 叢集名稱。與 CONTRACT.md 第 1 節一致，改動會導致 kind load 找不到叢集。
# CLUSTER_NAME=aegis-enclave

# kubeconfig 輸出路徑。Makefile 會 export KUBECONFIG 指向此檔，
# 避免污染 ~/.kube/config。
# KUBECONFIG_PATH=./infra/terraform/kubeconfig

# 容器映像標籤。CI 中會覆寫為含 commit SHA 的標籤。
# GATEWAY_IMAGE=aegis/gateway:dev
# DATAPLANE_IMAGE=aegis/dataplane:dev
