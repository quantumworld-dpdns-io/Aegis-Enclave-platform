# =============================================================================
#  Aegis-Enclave 環境變數範本
# =============================================================================
#
#  ⚠️  安全警告 —— 請務必先讀完這段再往下改
#
#  1. 這份檔案是「範本」，會進版控，因此裡面**只准出現假值或空值**。
#     使用方式：cp .env.example .env，然後把真實值填進 .env。
#
#  2. 絕對不要把真實憑證、私鑰、token 寫進 .env.example，也不要寫進任何
#     會被 git 追蹤的檔案。`.gitignore` 已排除 `.env` 與 `.env.*`
#     （並以 `!.env.example` 例外放行本檔），但 .gitignore 只防手滑，
#     不防刻意 `git add -f`。
#
#  3. 標記為【機密】的變數一律留空。它們在叢集中由 Kubernetes Secret
#     掛入，或由部署流程動態注入 —— 不應該存在於任何人的本機 .env 裡，
#     除非你正在做本機除錯。
#
#  4. 變數清單與預設值以 docs/CONTRACT.md 第 5 節為唯一真實來源。
#     若此處與契約不一致，以契約為準，並回報給骨架模組修正。
#
# =============================================================================


# -----------------------------------------------------------------------------
#  模組 B：gateway（Go + Gin 零信任閘道）
# -----------------------------------------------------------------------------

# 業務流量監聽位址。
AEGIS_LISTEN_ADDR=:8080

# 指標監聽位址。與業務流量分埠，是為了讓 Cilium 網路策略能只對 Prometheus
# 開放 9090，而不必把 /metrics 曝露在對外的 8080 上。
AEGIS_METRICS_ADDR=:9090

# 下游 dataplane 位址。這條路徑是 L7 策略唯一放行的服務間呼叫。
AEGIS_DATAPLANE_URL=http://dataplane.aegis.svc.cluster.local:8000

# 預期的 JWT issuer。不符者一律拒絕，避免接受他方簽發的 token。
AEGIS_JWT_ISSUER=https://aegis.local

# 預期的 JWT audience。防止其他服務的 token 被跨服務重放。
AEGIS_JWT_AUDIENCE=aegis-gateway

# JWKS 驗簽公鑰的掛載路徑。公鑰非機密，但輪替時必須與簽發端同步。
AEGIS_JWKS_PATH=/etc/aegis/jwks.json

# 是否強制用戶端憑證。零信任的前提就是這一條，除非在本機除錯，
# 否則不要改成 false。
AEGIS_REQUIRE_MTLS=true

# 每個 subject 每秒的請求上限。限流以假名化後的 subject 為單位，
# 因此單一憑證被盜也無法靠併發放大破壞力。
AEGIS_RATE_LIMIT_RPS=20

# 突發容量。允許短時間超過 RPS，以免正常的批次操作被誤殺。
AEGIS_RATE_LIMIT_BURST=40

# OTLP collector 端點。留空代表只走 Prometheus pull 模式，
# 這也是本機 demo 的預設路徑（少一個要維運的元件）。
AEGIS_OTEL_ENDPOINT=

# 日誌等級。調到 debug 前請先確認不會把請求內容整包印出來。
AEGIS_LOG_LEVEL=info


# -----------------------------------------------------------------------------
#  模組 C：dataplane（Python + FastAPI 資料安全服務）
# -----------------------------------------------------------------------------

# KMS driver：localstack / vault / aws 三選一。
# 預設 localstack 是為了讓整套流程完全免費且可離線 demo；
# 生產情境請切換到 aws 或 vault，因為 LocalStack 不是 FIPS 驗證的 HSM。
AEGIS_KMS_DRIVER=localstack

# 信封加密的主金鑰識別碼（CMK）。資料金鑰由它包裝，本身永不離開 KMS。
AEGIS_KMS_KEY_ID=alias/aegis-master

# localstack driver 專用端點。
AEGIS_KMS_ENDPOINT=http://localstack.aegis.svc.cluster.local:4566

# vault driver 專用位址。
AEGIS_VAULT_ADDR=http://vault.aegis.svc.cluster.local:8200

# 【機密】Vault token —— 留空。
# 來源：Kubernetes Secret 掛入（或本機除錯時用 `vault token create` 短期簽發）。
# 一旦洩漏等同於整個 transit 金鑰環被接管，切勿寫死在任何檔案裡。
AEGIS_VAULT_TOKEN=

# Vault transit 引擎的金鑰名稱。
AEGIS_VAULT_TRANSIT_KEY=aegis-master

# aws driver 專用區域。
AWS_REGION=ap-northeast-1

# 假名化 HMAC 金鑰的識別碼。與資料加密主金鑰分開，是為了做金鑰用途隔離：
# 拿到資料金鑰的人不應該同時具備反推假名的能力。
AEGIS_PSEUDONYM_SALT_KEY_ID=alias/aegis-pseudonym

# 區塊鏈 JSON-RPC 端點（本機為 Anvil，chainId 31337）。
AEGIS_CHAIN_RPC_URL=http://anvil.aegis.svc.cluster.local:8545

# 碳權合約位址 —— 留空。
# 來源：`forge script` 部署後由 contracts/deployments/local.json 讀出並注入。
AEGIS_CARBON_CONTRACT_ADDR=

# 日誌等級。稽核日誌禁止出現原始 PII、金鑰材料與完整 JWT，
# 調高詳細度時請一併確認遮罩仍生效。
AEGIS_LOG_LEVEL=info


# -----------------------------------------------------------------------------
#  本機工具鏈覆寫（非介面契約的一部分，僅影響 Makefile 行為）
# -----------------------------------------------------------------------------
#  下列變數不在 docs/CONTRACT.md 第 5 節內，服務本身不會讀取它們。
#  只有在你需要同時跑多座叢集、或推到自己的 registry 時才需要覆寫。

# CLUSTER_NAME=aegis-enclave
# GATEWAY_IMAGE=aegis/gateway:dev
# DATAPLANE_IMAGE=aegis/dataplane:dev
