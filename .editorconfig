# Aegis-Enclave 跨語言縮排與換行規範
#
# 這份設定的存在理由是：本 repo 同時有 Go、Python、Solidity、HCL、YAML 五種語言，
# 各自的官方格式化工具（gofmt / ruff / forge fmt / terraform fmt）對縮排的主張不同。
# 若不在編輯器層先對齊，PR 就會充滿與邏輯無關的空白差異，掩蓋真正需要審查的變更。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# --- Go ---
# gofmt 強制使用 tab，且不接受任何設定覆寫，因此編輯器必須讓步。
[*.go]
indent_style = tab
indent_size = 4

[go.mod]
indent_style = tab

[go.sum]
indent_style = tab

# --- Python ---
# 對齊 PEP 8 與 ruff 的預設值。
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{pyi,toml}]
indent_style = space
indent_size = 4

# --- Solidity ---
# 對齊 Solidity 官方 style guide 與 forge fmt 的預設值。
[*.sol]
indent_style = space
indent_size = 4
max_line_length = 120

# --- 組態檔（YAML / JSON / HCL）---
# Kubernetes manifest、GitHub Actions、Terraform 生態一律 2 空格。
[*.{yaml,yml,json,jsonc,hcl,tf,tfvars}]
indent_style = space
indent_size = 2

# --- Shell ---
# 對齊 bootstrap.sh / doctor.sh / demo-*.sh 既有的 2 空格風格。
[*.sh]
indent_style = space
indent_size = 2

# --- Makefile ---
# recipe 行必須以實體 tab 開頭，否則 make 會直接報 "missing separator"。
[Makefile]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

# --- Markdown ---
# 不修剪行尾空白：Markdown 用兩個空格表示強制換行，修掉會改變渲染結果。
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# --- 產出物與第三方程式碼 ---
# lockfile 與 vendored 相依由工具生成，不應被編輯器規則改動。
[{*.lock,uv.lock,go.sum,lcov.info}]
insert_final_newline = false
trim_trailing_whitespace = false

[contracts/lib/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false
