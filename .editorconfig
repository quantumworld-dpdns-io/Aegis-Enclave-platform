# Aegis-Enclave 跨語言縮排慣例
#
# 本檔的存在理由：monorepo 同時含 Go / Python / Solidity / Terraform / YAML / Shell，
# 六種語言的社群慣例互不相同。若只靠各語言的 formatter（gofmt、ruff、forge fmt、
# terraform fmt），編輯器在 formatter 尚未執行前就會先插入錯誤的縮排，
# 造成 diff 噪音。EditorConfig 讓編輯器在「打字的當下」就對齊各語言慣例。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go 使用 tab 是 gofmt 的硬性規定，不可改為空白。
[*.go]
indent_style = tab
indent_size = 4

# go.mod / go.sum 由 go 工具鏈產生，同樣使用 tab。
[{go.mod,go.sum}]
indent_style = tab
indent_size = 4

# PEP 8：4 空白。ruff format 的預設行寬為 88。
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# Solidity 官方 style guide 與 forge fmt 預設為 4 空白。
[*.sol]
indent_style = space
indent_size = 4

# HashiCorp 慣例：terraform fmt 輸出 2 空白。
[*.{tf,tfvars,hcl}]
indent_style = space
indent_size = 2

# YAML 不允許 tab 作為縮排字元（規格層級的限制）。
[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

# Google Shell Style Guide：2 空白，且 shell 對 tab 敏感度低但可讀性差。
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Markdown 行尾雙空白是「換行」語法，因此不可裁切行尾空白。
[*.{md,mdx}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Makefile 的規則行必須以 tab 開頭，否則 make 直接報錯。
[{Makefile,makefile,*.mk}]
indent_style = tab
indent_size = 4

# Dockerfile
[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_style = space
indent_size = 4

# 產生物與 vendored 相依不套用本專案慣例。
[{contracts/lib/**,**/*.lock,uv.lock,lcov.info}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
