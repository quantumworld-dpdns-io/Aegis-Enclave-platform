        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(aegis_authz_denied_total[5m]))",
          "legendFormat": "授權拒絕",
          "range": true,
          "refId": "B",
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(aegis_ratelimit_throttled_total[5m]))",
          "legendFormat": "限流",
          "range": true,
          "refId": "C",
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(aegis_http_requests_total{status=~\"40(1|3)\"}[5m]))",
          "legendFormat": "HTTP 401/403",
          "range": true,
          "refId": "D",
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(hubble_drop_total{reason=~\"(?i).*polic.*denied.*\"}[5m]))",
          "legendFormat": "Cilium 策略拒絕",
          "range": true,
          "refId": "E",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
