    {
      "id": 7,
      "type": "table",
      "title": "策略拒絕熱點",
      "description": "告警 runbook 指定的「策略拒絕熱點」面板。source / destination 標籤依 Hubble context 可能含 namespace 前綴。",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(20, sum by (source, destination, reason) (rate(hubble_drop_total{reason=~\"(?i).*polic.*denied.*\"}[5m])))",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "11.1.0",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "attacker 命名空間流出流量",
      "description": "零容忍訊號。對應 AegisAttackerNamespaceTrafficDetected。同時相容 labelsContext 與 podContext。",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (destination) (rate(hubble_flows_processed_total{source_namespace=\"attacker\"}[2m]))",
          "legendFormat": "ns {{destination}}",
          "range": true,
          "refId": "A",
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (destination) (rate(hubble_flows_processed_total{source=~\"attacker/.*\"}[2m]))",
          "legendFormat": "pod {{destination}}",
          "range": true,
          "refId": "B",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.1.0"
    },
