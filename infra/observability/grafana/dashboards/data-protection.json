        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(aegis_kms_decrypt_total[15m])) / clamp_min(sum(rate(aegis_kms_encrypt_total[15m])), 0.001)",
          "legendFormat": "ratio",
          "range": true,
          "refId": "A",
          "instant": true
