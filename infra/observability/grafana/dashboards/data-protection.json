    {
      "id": 4,
      "type": "stat",
      "title": "解密／加密比例",
      "description": "對應 AegisKmsDecryptEncryptRatioImbalanced（門檻 20）。先排除分母歸零再當外洩看。",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
